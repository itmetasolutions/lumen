# ---------- Required ----------
DATABASE_URL="postgresql://postgres:password@localhost:5432/lumen?schema=public"
AUTH_SECRET="change-me-to-a-long-random-string"

# ---------- Queue ----------
# pg (default, no extra infrastructure) | bullmq (requires REDIS_URL)
QUEUE_DRIVER="pg"
# REDIS_URL="redis://localhost:6379"

# ---------- Discovery providers (optional; each unlocks one adapter) ----------
# GOOGLE_MAPS_API_KEY=""            # Google Places API (New) — Text Search + Place Details
# SEARCH_PROVIDER_API_KEY=""        # SerpApi fallback key; Settings -> Connections is preferred
# SEARCH_PROVIDER_KIND="serpapi"    # serpapi
# SERPAPI_MONTHLY_LIMIT="250"       # local cap shared by SerpApi Google Maps, Yelp and Yandex
# SERPAPI_YELP_DOMAIN="yelp.com"
# SERPAPI_YANDEX_DOMAIN="yandex.com"
# SERPAPI_YANDEX_LANG="en"
# SERPAPI_YANDEX_LOCATION_ID=""     # optional SerpApi lr value
# OVERPASS_ENDPOINT="https://overpass-api.de/api/interpreter"   # OpenStreetMap; no key required

# ---------- Performance ----------
# GOOGLE_PAGESPEED_API_KEY=""       # PageSpeed Insights (works unkeyed at low volume, rate-limited)

# ---------- AI-assisted UX (strictly supplementary; findings marked AI-assisted) ----------
# OPENAI_API_KEY=""
# OPENAI_VISION_MODEL="gpt-4o-mini"

# ---------- Object storage for screenshots/exports (falls back to local disk) ----------
# S3_ENDPOINT=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_BUCKET=""
STORAGE_DIR=".data/storage"

# ---------- Crawler / browser ----------
# Reuse an already-installed browser instead of downloading one:
PLAYWRIGHT_CHANNEL="msedge"
CRAWLER_USER_AGENT="LumenAuditBot/0.1 (+website audit; contact: set CRAWLER_CONTACT)"
CRAWLER_CONTACT=""

# ---------- Cost / safety limits ----------
MAX_BUSINESSES_PER_DISCOVERY="500"
MAX_PAGES_PER_SITE_QUICK="1"
MAX_PAGES_PER_SITE_STANDARD="8"
MAX_PAGES_PER_SITE_DEEP="40"
WORKER_CONCURRENCY_DISCOVERY="2"
WORKER_CONCURRENCY_AUDIT="4"
